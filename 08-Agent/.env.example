# 08-Agent/.env.example — Agent server config (read via dotenv at boot).
#
# Real values live in the project-root .env (gitignored). Copy this file to .env
# in 08-Agent/ when you need to override locally.

# Supabase (already in root .env — duplicated here for documentation).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# AI image worker (see 08-Agent/workers/aiImageWorker.ts)
AI_IMAGE_PIPELINE_ENABLED=1
AI_IMAGE_AUTOGEN_URL=http://localhost:7790
AI_IMAGE_DAILY_BUDGET_USD=1.00

# AI image smoketest flag — gates /agent/ai-image/:id.png + /agent/feed-ai-images
# Used by hem* test environment in 06-UI. Leave false in production.
AI_SMOKETEST_ENABLED=false

# AI image rollout kill switch for Utforska tab.
# false → useAiImageUrl returns source='empty' for all events (server-side enforced)
# true  → useAiImageUrl prefers AI images: pre-baked → lazy → empty
# (Client-side flag is EXPO_PUBLIC_AI_IMAGE_EXPLORE_ENABLED — they should match.)
AI_IMAGE_EXPLORE_ENABLED=false

# Admin auth (Bearer token) for /agent/metrics, /agent/ai-image/optout, etc.
AGENT_ADMIN_TOKEN=

# Agent API origin allowlist (comma-separated).
AGENT_ALLOWED_ORIGINS=

# BFL Flux API key (https://api.bfl.ai).
BFL_API_KEY=
