{
  "name": "@eventpulse/newstructure",
  "version": "1.0.0",
  "private": true,
  "description": "EventPulse NEWSTRUCTURE — self-contained pipeline root",
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "batch": "tsx 08-testResults/260330-batch1-10.ts",
    "worker": "tsx 03-Queue/startWorker.ts",
    "import:sources": "tsx 00-Sources/00A-ImportRawSources-Tool/import-raw-sources.ts --all --output runtime/import-preview.jsonl --apply-new",
    "dashboard:live": "tsx dashboard-live.ts",
    "venue-graph:dry-run": "tsx 07-Discovery/src/venueGraph/runVenueGraph.ts",
    "venue-graph:apply": "tsx 07-Discovery/src/venueGraph/runVenueGraph.ts --apply",
    "source-candidates:test": "tsx 07-Discovery/src/sourceTesting/runSourceCandidateTests.ts",
    "start:agent": "tsx 08-Agent/server.ts",
    "type-check:agent": "tsc --noEmit 08-Agent/**/*.ts",
    "restamp:one": "tsx --env-file=.env 08-Agent/scripts/restamp_aigenerated_one.ts",
    "restamp:all": "tsx --env-file=.env 08-Agent/scripts/restamp_all_event_posters.ts",
    "verify:ai-stamp": "tsx --env-file=.env 08-Agent/scripts/verify_ai_compliance.ts",
    "stamp:seed-originals": "tsx --env-file=.env 08-Agent/scripts/seed_ai_originals.ts",
    "stamp:build": "tsx --env-file=.env 08-Agent/scripts/build_ai_stamped.ts",
    "stamp:scan-legacy": "tsx --env-file=.env 08-Agent/scripts/scan_legacy_xmp.ts",
    "stamp:quarantine": "tsx --env-file=.env 08-Agent/scripts/quarantine_legacy_stamps.ts",
    "stamp:restamp-events": "tsx --env-file=.env 08-Agent/scripts/restamp_events_bucket.ts",
    "stamp:build-ruined": "tsx --env-file=.env 08-Agent/scripts/build_ruined_into_stamped.ts",
    "stamp:repoint-ruined": "tsx --env-file=.env 08-Agent/scripts/repoint_ruined_events.ts",
    "stamp:quarantine-ruined": "tsx --env-file=.env 08-Agent/scripts/quarantine_ruined_files.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@eventpulse/shared": "file:./packages/shared",
    "@supabase/supabase-js": "^2.43.0",
    "axios": "^1.6.0",
    "bullmq": "^5.7.0",
    "cheerio": "^1.0.0-rc.12",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "fast-xml-parser": "^5.11.0",
    "ioredis": "^5.3.0",
    "meilisearch": "^0.40.0",
    "node-cron": "^3.0.0",
    "openai": "^7.5.0",
    "puppeteer": "^24.40.0",
    "sharp": "^0.35.3",
    "tsx": "^4.21.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "@types/node-cron": "^3.0.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.8",
    "@vitest/ui": "^4.1.4",
    "pg": "^8.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
