# Cloudflare Pages headers — applied per pattern
# 2026-10-06: web companion pivot — added Supabase REST + Leaflet CDN allowlist.

/*
  Strict CSP, expanded for:
    - api.supabase.co (REST-fetch från klienten för events/categories/venues)
    - basemaps.cartocdn.com (Leaflet dark-tiles, öppen fri tile-tjänst)
    - unpkg.com (Leaflet CSS + JS)
    - *.supabase.co/storage (image_url på event-kort och detaljsida)
    - inline styles (vi har några style="…" på map-list items)

  Privata fält (lat/lng, address) läses endast om publishable-anon-nyckeln
  (se migrations/20261006-0004) — inga cookies, ingen session.
*/
Content-Security-Policy: default-src 'self'; script-src 'self' https://unpkg.com 'unsafe-inline'; style-src 'self' https://unpkg.com 'unsafe-inline'; font-src 'self'; img-src 'self' data: https://*.supabase.co https://tile.openstreetmap.org https://*.openstreetmap.org https://tile.openstreetmap.de https://*.basemaps.cartocdn.com; connect-src 'self' https://*.supabase.co https://tile.openstreetmap.org https://*.openstreetmap.org; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
Referrer-Policy: strict-origin-when-cross-origin
X-Content-Type-Options: nosniff
X-Frame-Options: DENY
Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static asset cache — 5 min under dev iteration. Byt till immutable när vi
# är klara med alla assets (efter NOW#6 web companion stabiliserats).
/assets/*
  Cache-Control: public, max-age=300, must-revalidate

# HTML — kort default. web akan byggas ofta.
/*.html
  Cache-Control: public, max-age=300, must-revalidate
/
  Cache-Control: public, max-age=300, must-revalidate