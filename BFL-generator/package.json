{
  "name": "bfl-generator",
  "version": "0.1.0",
  "private": true,
  "description": "Klustrar events, räknar BFL-bildbehov, genererar bilder via befintlig round5-pipeline.",
  "type": "module",
  "scripts": {
    "quota": "tsx lib/quota.ts",
    "plan": "tsx bin/bfl-plan.ts",
    "cluster": "tsx bin/bfl-cluster-real.ts",
    "batch": "node --env-file=../.env --import tsx bin/bfl-batch.ts",
    "match": "tsx bin/bfl-match-test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "@types/node": "^20.12.0"
  }
}