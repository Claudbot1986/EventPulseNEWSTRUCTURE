<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Veckovis körning: source_quality_report --full (URL-hälsotest 200 HEAD:er).
  Söndagar kl 06:00. Separat från runDaily för att inte tynga daglig pipeline.

  Installera med:
    cp com.eventpulse.weekly.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.eventpulse.weekly.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eventpulse.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/claudgashi/EventPulse/09-ScrapingSupervisor/cron/runWeekly.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>0</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/claudgashi/EventPulse/runtime/scraping-supervisor/weekly-stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/claudgashi/EventPulse/runtime/scraping-supervisor/weekly-stderr.log</string>
  <key>WorkingDirectory</key>
  <string>/Users/claudgashi/EventPulse</string>
</dict>
</plist>