<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eventpulse.supervisor</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/claudgashi/EventPulse/node_modules/tsx/dist/cli.mjs</string>
    <string>/Users/claudgashi/EventPulse/09-ScrapingSupervisor/runDaily.ts</string>
