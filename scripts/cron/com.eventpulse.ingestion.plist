<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.eventpulse.ingestion.plist — THE nightly chain (enda nattjobbet).

  Runs daily at 02:00. Executes scripts/cron/runNightly.sh which runs
  the whole night in sequence:
    ingestion (13 steg) → purge → supervisor → discovery

  Separata launchd-tider för purge/supervisor/discovery pensionerade
  2026-09-16 (beslut: "en enda kedja"). Deras plists ligger i
  ~/Library/LaunchAgents/_quarantine-2026-09-16/ — installera inte om dem.

  D-images körs med SKIP_BFL=1 (bibliotek-fallback istället för BFL-generering)
  tills BFL-credits fyllts på — beslut 2026-09-15.

  Schedule:
    Hour=2  Minute=0   (daily)
  Kedjan fortsätter alltid vidare även om ett steg faller; wrappern
  avslutar med exit 1 om något steg föll (syns i launchctl list).

  Install:
    cp scripts/cron/com.eventpulse.ingestion.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.eventpulse.ingestion.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.eventpulse.ingestion.plist
    rm ~/Library/LaunchAgents/com.eventpulse.ingestion.plist

  Statusfil (för dashboard 7777):
    runtime/ingestion-cron.status.json

  Säkerhet:
    - WorkingDirectory pekar på projektets working tree (uppdatera sökvägen
      om du flyttar repot).
    - launchd ärver .env via shell-wrapper (runIngestion.sh) så alla hemliga
      nycklar från .env exponeras ENBART för ingestion-processen.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eventpulse.ingestion</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/claudgashi/EventPulse/scripts/cron/runNightly.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/claudgashi/EventPulse</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/claudgashi/EventPulse/runtime/ingestion-cron/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/claudgashi/EventPulse/runtime/ingestion-cron/launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/claudgashi/.local/bin</string>
    <!-- SKIP_BFL=1: D-images använder bildbiblioteket som fallback (ingen
         BFL-generering) tills BFL-credits fyllts på. Ta bort denna key för
         att återgå till BFL. -->
    <key>SKIP_BFL</key>
    <string>1</string>
  </dict>

  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
</dict>
</plist>
