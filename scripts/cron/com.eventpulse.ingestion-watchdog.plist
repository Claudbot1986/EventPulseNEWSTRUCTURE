<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.eventpulse.ingestion-watchdog.plist — Health watchdog for ingestion chain.

  Runs every 5 minutes. Checks:
    - chain-overview.log har fresh heartbeats
    - status.json chain PID är vid liv
    - chain inte är hung längre än WATCHDOG_STEP_HUNG_MS (default 30 min)
    - chain inte överskrider WATCHDOG_CHAIN_ALIVE_MS (default 6h)

  Exit 0 alltid (watchdog reporting ska inte göra att launchd tror av watchdog).

  Install:
    cp scripts/cron/com.eventpulse.ingestion-watchdog.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.eventpulse.ingestion-watchdog.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.eventpulse.ingestion-watchdog.plist
    rm ~/Library/LaunchAgents/com.eventpulse.ingestion-watchdog.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eventpulse.ingestion-watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>cd /Users/claudgashi/EventPulse && . ./.env 2>/dev/null; exec ./node_modules/.bin/tsx scripts/cron/ingestion-watchdog.ts</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/claudgashi/EventPulse</string>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/claudgashi/EventPulse/runtime/ingestion-cron/watchdog-launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/claudgashi/EventPulse/runtime/ingestion-cron/watchdog-launchd.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/claudgashi/.local/bin</string>
  </dict>
</dict>
</plist>