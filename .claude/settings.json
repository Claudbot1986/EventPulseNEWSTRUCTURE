{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(/**/*.png)",
      "Read(/**/*.jpg)",
      "Read(/**/*.jpeg)",
      "Read(/**/*.gif)",
      "Read(/**/*.webp)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/no-branches.py\"",
            "statusMessage": "Branch-vakt…"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/term-bg.py\" reset",
            "statusMessage": "Din tur — återställer terminalfärg…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/term-bg.py\" green",
            "statusMessage": "Claude jobbar — målar terminalen grön…"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/term-bg.py\" capture",
            "statusMessage": "Sparar terminalfärg…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/term-bg.py\" reset",
            "statusMessage": "Återställer terminalfärg…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/simple-swedish-options.py\"",
            "statusMessage": "Alternativ-vakt…"
          },
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/term-bg.py\" green",
            "statusMessage": "Målar terminalen grön…"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/svarsformat-guard.py\"",
            "statusMessage": "Svarsformat-vakt…"
          },
          {
            "type": "command",
            "command": "python3 \"/Users/claudgashi/EventPulse/.claude/hooks/term-bg.py\" reset",
            "statusMessage": "Återställer terminalfärg…"
          }
        ]
      }
    ]
  }
}