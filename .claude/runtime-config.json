{
  "schema_version": "ep-runtime-config-1.0",
  "project_root": "/Volumes/2TB filer/NEWSTRUCTURE-COPY",
  "repo_marker": ".claude/eventpulse/policy.md",
  "repo_identity_check": {
    "expected_path_suffix": "/Volumes/2TB filer/NEWSTRUCTURE-COPY",
    "marker_file": ".claude/eventpulse/policy.md"
  },
  "optimizer": {
    "max_concurrent_jobs": 1,
