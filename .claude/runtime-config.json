  "launchd": {
    "label": "com.eventpulse.optimizer",
    "plist_filename": "com.eventpulse.optimizer.plist",
    "keep_alive": true,
    "run_at_load": true,
    "log_dir": "/Users/claudgashi/Library/Logs/eventpulse-optimizer"
  },
  "telemetry": {
    "review_every_n_episodes": 20,
    "review_format": "ep-review-1.0"
  }
