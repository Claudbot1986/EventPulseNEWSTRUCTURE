# 06-UI/.env.example — Expo client config (EXPO_PUBLIC_* injected at bundle time).
#
# Real values live in the project-root .env (gitignored). Copy this file to .env
# in 06-UI/ when you need to override locally.

# Agent API base URL (Tailscale in prod, LAN for local dev).
EXPO_PUBLIC_AGENT_URL=
EXPO_PUBLIC_AGENT_URL_LAN=

# AutoGen server host (port 7790) used by hem* test environment.
EXPO_PUBLIC_AUTOGEN_HOST=

# AI image smoketest flag — gates /agent/ai-image/:id.png + /agent/feed-ai-images
# (hem* test environment only). Leave false in production.
EXPO_PUBLIC_AI_SMOKETEST_ENABLED=false
