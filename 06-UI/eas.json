{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_DEMO_LOGIN": "true",
        "EXPO_PUBLIC_DEMO_EMAIL": "demo@eventpulse.nu"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
