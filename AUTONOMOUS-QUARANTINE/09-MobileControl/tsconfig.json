{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": false
  },
  "include": ["./*.ts", "./tests/*.ts"],
  "exclude": ["node_modules", "dist"]
}