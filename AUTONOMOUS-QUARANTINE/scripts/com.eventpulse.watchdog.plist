<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.eventpulse.watchdog.plist — health watchdog for the autonomous-loop wrapper.

  Runs scripts/run-watchdog.sh every 2 hours. The watchdog inspects
  runtime/autonomous-loop/{state.json, wrapper.pid, loop.log} and:

    - HEALTHY:          exit 0, do nothing
    - STUCK:            SIGTERM the wrapper (launchd KeepAlive respawns it)
    - DEAD:             launchctl kickstart -k the launchd job
    - BUDGET_LOOP:      log alert (user must raise MAX_BUDGET_PER_ITER or
                        shrink task scope)

  Why this exists:
    launchd KeepAlive only catches crashes. A wrapper that is alive but
    stuck (e.g. claude --print hanging, or budget-loop burning $15 every
    18 seconds) looks healthy to launchd but produces no progress. The
    watchdog catches that.

  Install:
    cp scripts/com.eventpulse.watchdog.plist ~/Library/LaunchAgents/
    launchctl load -w ~/Library/LaunchAgents/com.eventpulse.watchdog.plist

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.eventpulse.watchdog.plist
    rm ~/Library/LaunchAgents/com.eventpulse.watchdog.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eventpulse.watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/claudgashi/bin/run-watchdog.sh</string>
  </array>

  <!-- The wrapper script lives at ~/bin/run-watchdog.sh because macOS
       launchd cannot execute scripts on the /Volumes/2TB filer mount
       (sandbox/TCC block: exit 78 EX_CONFIG). The script itself reads from
       /Volumes/2TB filer/NEWSTRUCTURE-COPY/... and writes to the same paths
       — those are file reads/writes, which work fine. Only direct script
       execution is restricted. -->

  <key>RunAtLoad</key>
  <true/>

  <key>WorkingDirectory</key>
  <string>/Users/claudgashi</string>

  <!-- Run every 2 hours. launchd fires even when the previous run crashed;
       the watchdog is idempotent and read-only on wrapper state. -->
  <key>StartInterval</key>
  <integer>7200</integer>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- launchd cannot open files for write on /Volumes/2TB filer (sandbox).
       The watchdog itself writes its decisions to
       runtime/autonomous-loop/watchdog.log (a regular file write from the
       launched process, which works fine). These /tmp paths are for launchd's
       own bookkeeping only. -->
  <key>StandardOutPath</key>
  <string>/tmp/com.eventpulse.watchdog.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.eventpulse.watchdog.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PROJECT_ROOT</key>
    <string>/Volumes/2TB filer/NEWSTRUCTURE-COPY</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/Users/claudgashi/.local/bin</string>
    <key>WATCHDOG_STUCK_HOURS</key>
    <string>4</string>
    <key>WATCHDOG_DEAD_MIN</key>
    <string>30</string>
    <key>WATCHDOG_BUDGET_LOOP</key>
    <string>3</string>
  </dict>
</dict>
</plist>
