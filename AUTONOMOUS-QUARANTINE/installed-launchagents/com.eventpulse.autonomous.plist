<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.eventpulse.autonomous.plist — launchd job for the EventPulse autonomous loop.

  Loads on boot, keeps the wrapper running. macOS will restart the wrapper
  process on exit (KeepAlive=true). Logs go to ~/Library/Logs via launchd.

  Install with:
    ./scripts/install-autonomous-loop.sh

  Uninstall with:
    launchctl unload ~/Library/LaunchAgents/com.eventpulse.autonomous.plist
    rm ~/Library/LaunchAgents/com.eventpulse.autonomous.plist

  Customise:
    - PROJECT_ROOT: where the repo lives (default = /Volumes/2TB filer/NEWSTRUCTURE-COPY)
    - MAX_TOTAL_HOURS: hard cap on wall-clock runtime
    - MAX_BUDGET_PER_ITER: USD per claude --print call
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.eventpulse.autonomous</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Volumes/2TB filer/NEWSTRUCTURE-COPY/scripts/autonomous-loop.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Volumes/2TB filer/NEWSTRUCTURE-COPY</string>

  <!-- Auto-start at boot/login -->
  <key>RunAtLoad</key>
  <true/>

  <!-- Restart on any exit (success, failure, signal). macOS rate-limits
       restart attempts to ~10s minimum via ThrottleInterval. -->
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
    <key>Crashed</key>
    <true/>
  </dict>

  <!-- Don't restart more than once every 10 seconds (prevents tight crash loops). -->
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Environment: override defaults via EnvironmentVariables. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PROJECT_ROOT</key>
    <string>/Volumes/2TB filer/NEWSTRUCTURE-COPY</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/Users/claudgashi/.local/bin</string>
    <key>MAX_TOTAL_HOURS</key>
    <string>168</string>
    <key>MAX_BUDGET_PER_ITER</key>
    <string>15</string>
    <key>MAX_RESTARTS</key>
    <string>1000</string>
  </dict>

  <!-- Logs: launchd captures stdout/stderr to these files. -->
  <key>StandardOutPath</key>
  <string>/Volumes/2TB filer/NEWSTRUCTURE-COPY/runtime/autonomous-loop/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/2TB filer/NEWSTRUCTURE-COPY/runtime/autonomous-loop/launchd.err.log</string>

  <!-- Resource limits: prevent runaway memory/CPU. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>256</integer>
  </dict>
</dict>
</plist>
