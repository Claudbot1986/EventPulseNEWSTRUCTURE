# =============================================================================
# EventPulse — environment variables
# =============================================================================
#
# This file is a TEMPLATE. It contains placeholders only — no real secrets.
# Copy to .env for local dev, or set via `fly secrets set` for production.
#
# ─── PUBLIC / CLIENT-SAFE ────────────────────────────────────────────────────
# Variables prefixed with EXPO_PUBLIC_ are bundled into the shipped Expo
# JavaScript. They are PUBLIC to anyone who downloads/installs the app.
# Only put publishable keys here (e.g. the Supabase *anon/publishable* key).
# The Expo app reads these from 06-UI/.env.local, NOT from this repo file.
#
# ─── SERVER-ONLY SECRETS ────────────────────────────────────────────────────
# Variables WITHOUT the EXPO_PUBLIC_ prefix must never be bundled into
# the client. They are read by Node code on the server (08-Agent and the
# ingestion stack). Treat them as confidential.
#
# Rotation policy: any value pasted into the repo, a commit message, or a
# screenshot must be assumed COMPROMISED and rotated immediately.
# =============================================================================


# ─── 08-Agent (private agent API) ────────────────────────────────────────────
# Port the agent server listens on. server.ts defaults to 8787 when unset.
# Fly's internal_port must match this.
AGENT_PORT=8787

# Comma-separated origin allowlist for CORS on /agent/* endpoints.
# The Expo app's origin must be listed. Use the deployed fly.dev URL.
AGENT_ALLOWED_ORIGINS=https://your-app-name.fly.dev

# Bearer token required to call /agent/metrics and
# /agent/experiments/personalization. The endpoint fails closed (503) when
# this is unset. Generate with: openssl rand -hex 32
AGENT_ADMIN_TOKEN=replace-me-with-32-bytes-of-randomness


# ─── Supabase (server-side, service-role) ────────────────────────────────────
# SERVER-ONLY. The service-role key bypasses Row Level Security — never
# put it in EXPO_PUBLIC_* and never expose it to the Expo bundle.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_service_role_REPLACE_ME


# ─── LLM / Anthropic (08-Agent llmRouter) ────────────────────────────────────
# SERVER-ONLY. Required for the Phase 1 composer (claude-haiku-4-5). Without
# it the agent degrades to a deterministic template reply (see llmRouter.ts).
# Get yours at https://console.anthropic.com — never paste it into a repo.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME


# ─── AI image smoketest (Step A, copyright-safe pipeline) ──────────────────
# SERVER-ONLY. OpenAI API key for the gpt-image-1 generator. Optional —
# only needed when running scripts/generate_ai_image_smoketest.ts. The
# /agent/ai-image/* endpoints fail closed (404) when this is unset.
# Get yours at https://platform.openai.com — never paste it into a repo.
OPENAI_API_KEY=sk-openai-REPLACE_ME

# Feature flag for the AI image smoketest endpoints:
#   0 / unset / false → endpoints return 404 (default — safe default)
#   1 / true          → endpoints serve from runtime/ai-image-smoketest/
# Step A is gated by this flag so the route never appears unless the
# developer explicitly opts in.
AI_SMOKETEST_ENABLED=0

# Optional override for the smoketest runtime directory. Defaults to
# <project>/runtime/ai-image-smoketest if unset. The script writes here
# and the middleware reads from here — they must agree.
# AI_IMAGE_SMOKETEST_DIR=/absolute/path/to/runtime/ai-image-smoketest

# ─── AI image smoketest (cheaper Step B provider) ────────────────────────
# SERVER-ONLY. Black Forest Labs API key for the Flux generator. Drop-in
# replacement for OPENAI gpt-image-1 — ~20× cheaper per image (~$0.003
# vs ~$0.06). The pipeline (`08-Agent/tools/ai_image.ts → generateOne()`)
# uses whichever key is set, no code change needed to switch providers.
# Get yours at https://api.bfl.ai — never paste it into a repo.
BFL_API_KEY=bfl_REPLACE_ME


# ─── AI image pipeline (mandatory, 2026-08-25) ───────────────────────────────
# Master switch for the AI-image-as-mandatory pipeline. When 0 / unset /
# false, the normalizer does NOT enqueue AI jobs and the worker does NOT
# start; events keep image_url = NULL and the UI shows its fallback. When
# 1 / true, every ingested event with NULL image_url is enqueued onto the
# ai-image-generation queue, consumed by 08-Agent/workers/aiImageWorker.ts.
# This is the kill switch — flip to 0 in any environment where AI gen
# must pause without redeploying.
AI_IMAGE_PIPELINE_ENABLED=1

# Daily USD spend cap for the aiImageWorker. ~$0.025/image at BFL flux-dev.
# When the worker has spent >= this cap in the current UTC day, it sleeps
# until 00:00 UTC before processing more jobs. Existing failed jobs are
# not lost — they retry the next day (or sooner if cap is raised). Status
# 'no_credits' rows are skipped until BFL balance is recharged (separate
# from this cap).
AI_IMAGE_DAILY_BUDGET_USD=1.0

# URL of the autoGenServer that actually generates images. The worker
# POSTs {events: [...]} here (dedup-grouped) and reads back image_url.
# Default points at the locally-running asterisk server (06-UI/asterisk/
# autoGenServer.js), port 7790. In Fly deployments set this to the
# internal URL of the autogen fly app.
AI_IMAGE_AUTOGEN_URL=http://localhost:7790


# ─── Expo app (client-side, public values) ───────────────────────────────────
# These are referenced by 06-UI/.env.local and bundled into the JS bundle.
# Treat the anon key as a low-privilege publishable token; the URL is public.

# Expo reads the agent backend URL through the app's own .env.local.
# Point this at the deployed Fly URL, not a LAN IP, when shipping.
EXPO_PUBLIC_AGENT_URL=https://your-app-name.fly.dev

# Supabase anon/publishable key — public by design, but rotate if exposed
# in a place that wasn't expected (commit, screenshot, public log).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME


# ─── Ingestion (2-/4-/9-/etc.) — NOT used by 08-Agent runtime ───────────────
# Listed here for completeness; the agent API does not depend on these.
# Avoid setting them on the agent's Fly app. They belong on a separate
# worker/scheduler app (or on the developer machine) that drives ingestion.

# Redis used by BullMQ jobs in 03-Queue.
REDIS_URL=redis://localhost:6379

# Meilisearch for search indexing (06-UI/services/ingestion/src/search.ts).
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=masterKey_REPLACE_ME
MEILISEARCH_INDEX=events

# Direct-API ingestion keys (Ticketmaster, Eventbrite, Billetto).
TICKETMASTER_API_KEY=tm_REPLACE_ME
EVENTBRITE_API_KEY=eb_REPLACE_ME
BILLETTO_API_KEY=billetto_REPLACE_ME

# Render-gate render-fallback keys (D-renderGate).
SCRAPINGBEE_API_KEY=sb_REPLACE_ME
MINIMAX_API_KEY=minimax_REPLACE_ME
MINIMAX_API_BASE=https://api.example.invalid/v1

# Cloudflare worker used by cloudflareAdapter as a fetch proxy.
CLOUDFLARE_WORKER_URL=https://your-worker.example.workers.dev
CLOUDFLARE_API_TOKEN=cf_token_REPLACE_ME

# Local sandbox root for ingestion tooling (paths in 02-Ingestion runners).
EVENTPULSE_SANDBOX_ROOT=/absolute/path/to/project

# Used by the 09-ScrapingSupervisor (separate process from the agent).
EVENTPULSE_PROJECT_ROOT=/absolute/path/to/project
EVENTPULSE_VAULT_ROOT=/absolute/path/to/MyVault

# Migration scripts use DATABASE_URL (Postgres connection string).
DATABASE_URL=postgres://user:password@host:5432/dbname


# ─── Dashboard (09-ScrapingSupervisor dashboard, separate process) ──────────
PORT=7777
AGENT_METRICS_URL=http://localhost:8787/agent/metrics
