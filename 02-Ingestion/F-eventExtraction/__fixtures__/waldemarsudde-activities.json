      "rendered": "Guided tour in English"
    },
    "content": {
      "rendered": "<section class=\"w-full relative flex flex-row section h-halfscreen md:h-screen items-end bg-cover bg-no-repeat\">\n                        <img decoding=\"async\" src=\"https://waldemarsudde.se/wp-content/uploads/2023/03/DSC3852_Prins_Eugens_Waldemarsudde_AndersES-beskuren-uppljusad.png\" alt=\"\" title=\"Foto: Anders E Skånberg\" class=\"bg-animation w-full h-full object-cover z-20 absolute top-0 left-0\">\n                \n    <div class=\"section-inner w-full space-y-8 pb-14 md:pb-28 z-30\">\n                    </div>\n</section>\n<section class=\"breadcrumb\">\n    <div class=\"section-inner pt-8 pb-0\">\n    <span id=\"breadcrumbs\"><span><span><a href=\"https://waldemarsudde.se/\">Hem</a></span></span></span>    </div>\n</section>\n\n<section class=\"section bg-white\">\n    <div class=\"section-inner\">\n        <div class=\"w-full\">\n                            <h2 class=\"heading-2\">Guided tour in English</h2>\n                                        <h3 class=\"heading-3 font-serif\">Friday, August 15 at 1 p.m.</h3>\n                        <div class=\"separator\"></div>\n        </div>\n        <div class=\"flex flex-wrap md:flex-nowrap  space-x-0 md:space-x-8\">\n                            <div class=\"w-full md:w-1/2 lg:w-2/3\">\n                    <div class=\"mr-3.5\">\n                        <p data-start=\"57\" data-end=\"140\"><strong data-start=\"57\" data-end=\"140\">Welcome to a Guided Tour of the Public Apartments at Prins Eugens Waldemarsudde</strong></p>\n<p data-start=\"142\" data-end=\"326\">Join us for an introduction to the life of Prince Eugen. During the tour, you&#8217;ll discover his art, explore parts of his remarkable art collection, and learn about the beautiful home he created.</p>\n<p data-start=\"328\" data-end=\"485\">The guided tour is included in the entrance fee—no additional tickets are required. It begins in the public apartments and lasts approximately 20–30 minutes.</p>\n<p data-start=\"328\" data-end=\"485\">\n                    </div>\n                                    </div>\n                        \n            <div class=\"w-full md:w-1/2 lg:w-1/3 mt-6 mb-6 md:mt-0\">\n            \n                <div class=\"flex flex-col space-y-4\">\n                                    </div>\n            </div>\n        </div>\n    </div>\n</section>",
      "protected": false
    }
